# Meta app credentials — get these from developers.facebook.com
# The secret must NEVER be exposed to the browser. Server-side only.
META_APP_ID=
META_APP_SECRET=

# Verify token you choose; Meta echoes it back when registering webhooks.
META_WEBHOOK_VERIFY_TOKEN=

# Public URL of this app. Used to build the OAuth redirect_uri.
# Must match exactly what is registered in the Meta app settings.
APP_URL=http://localhost:3000

# FastAPI backend, once it exists.
# RIVON_API_URL=

# Embedded Signup — these two are PUBLIC (they appear in the browser).
# Get the config id from: App Dashboard > Facebook Login for Business >
# Configurations > create one with the "WhatsApp Embedded Signup" variation.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=

# Two-step verification PIN used when registering a tenant's number.
# TODO: generate per tenant and store; this default is for local testing only.
WHATSAPP_REGISTER_PIN=

# WhatsApp test number, from App Dashboard > WhatsApp > API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
